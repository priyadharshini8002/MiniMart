# Copy this file to ".env" and fill in your own values.
# NEVER upload the real .env file to GitHub.

PORT=5000

# Local MongoDB (or paste your MongoDB Atlas connection string here)
MONGO_URI=mongodb://127.0.0.1:27017/minimart

# Any long random text. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_secret

# Razorpay TEST keys (added in Phase 12)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
